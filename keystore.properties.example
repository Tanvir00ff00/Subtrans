# Copy to keystore.properties (gitignored) and fill in to sign release builds
# locally. CI reads the same values from repository secrets instead.
#
# Create a key once with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias subtrans
#
# Keep release.jks safe and backed up. If it is lost, no future build can
# update an already-installed copy of the app.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=subtrans
keyPassword=CHANGE_ME
